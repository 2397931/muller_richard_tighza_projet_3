  m_Script: {fileID: 11500000, guid: 6337c12768e06a84dac32c8fcb5040f7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  speakerName: Marchand
  sentences:
  - "\"Bienvenue, aventurier\u2026\""
  - "\"Si tu veux quitter ce donjon, tu vas devoir m\u2019aider.\""
  - "\"Il y a 10 objets cach\xE9s dans le donjon.\""
  - "\"Ram\xE8ne-les tous au d\xE9p\xF4t ici.\""
  - "\"Seulement quand j\u2019aurai re\xE7u les 10 objets, je te donnerai la cl\xE9
    de sortie.\""
  - "\"Bonne chance\u2026 tu vas en avoir besoin.\""
